  },
  "dependencies": {
    "@dimforge/rapier3d-compat": "^0.20.0",
    "astronomy-engine": "^2.1.19",
    "three": "^0.185.1"
  },
  "devDependencies": {
    "@gltf-transform/cli": "^4.5.0",
    "@types/three": "^0.185.0",
    "typescript": "^5.9.2",
    "vite": "^8.2.2"
  }
}
